#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <inttypes.h>

#include "processing.h"
#include "utils.h"

#ifdef WIN32
#define PATH_SEPARATOR '\\'
#else
#define PATH_SEPARATOR '/'
#endif

#define MAX_PATH_LENGTH 250
#define READ_BUFFER_SIZE_MB 5


void initialize_session(const char *sessionPath_p, uint64_t *maxChunkIndex_p, char **outputPath_pp) {
    // find highest chunk index
    _find_max_chunk_index(maxChunkIndex_p, sessionPath_p);
    if (*maxChunkIndex_p == 0) {
        fprintf(stderr, "ERROR: No input files found\n");
        exit(1);
    }
    
    // create output directory
    *outputPath_pp = malloc(strlen(sessionPath_p) + 7);
    if (*outputPath_pp == NULL) {
        fprintf(stderr, "ERROR: Memory allocation failed\n");
        exit(1);
    }
    sprintf(*outputPath_pp, "%s%c%s%c", sessionPath_p, PATH_SEPARATOR, "out", PATH_SEPARATOR);
    _create_output_folder(*outputPath_pp);
}


void initialize_buffers(const WavHeader *inputHeader_p, size_t totalBufferSizeMB, 
                       uint8_t ***writeBuffers_pp, size_t **bufferFillBytes_pp, 
                       size_t *bufferSizeBytes_p) {
    // calculate buffer size per channel
    *bufferSizeBytes_p = (totalBufferSizeMB * 1024 * 1024) / inputHeader_p->num_channels;
    printf("Buffer size per channel: %.2f MB\n", *bufferSizeBytes_p / (1024.0 * 1024.0));

    // allocate buffer arrays
    *writeBuffers_pp = malloc(inputHeader_p->num_channels * sizeof(uint8_t *));
    *bufferFillBytes_pp = malloc(inputHeader_p->num_channels * sizeof(size_t));
    
    if (*writeBuffers_pp == NULL || *bufferFillBytes_pp == NULL) {
        fprintf(stderr, "ERROR: Failed to allocate buffer arrays\n");
        exit(1);
    }

    // allocate individual channel buffers
    for (int currentChannel = 0; currentChannel < inputHeader_p->num_channels; currentChannel++) {
        (*writeBuffers_pp)[currentChannel] = malloc(*bufferSizeBytes_p);
        (*bufferFillBytes_pp)[currentChannel] = 0;
        
        if ((*writeBuffers_pp)[currentChannel] == NULL) {
            fprintf(stderr, "ERROR: Failed to allocate write buffer for channel %d\n", currentChannel + 1);
            exit(1);
        }
    }
}


FILE* read_chunk_header(uint64_t chunkIndex, const char *sessionPath_p, 
                        WavHeader *inputHeader, FILE ***outputFiles_pp, 
                        size_t **bytesWritten_pp, const char *outputPath_p) {
    // build file path
    char inputFilePath[MAX_PATH_LENGTH];
    sprintf(inputFilePath, "%s%c%08" PRIX64 ".WAV", sessionPath_p, PATH_SEPARATOR, chunkIndex);
    inputFilePath[MAX_PATH_LENGTH - 1] = '\0';

    printf("Processing input file: %s\n", inputFilePath);

    // open file
    FILE *inputFile_p = fopen(inputFilePath, "rb");
    if (!inputFile_p) {
        fprintf(stderr, "ERROR: Failed to open input file\n");
        _cleanup(outputFiles_pp, inputHeader->num_channels, (uint64_t **)bytesWritten_pp);
        exit(-1);
    }

    // read header
    if (read_header(inputFile_p, inputHeader) != 0) {
        fprintf(stderr, "ERROR: Failed to read WAV header\n");
        fclose(inputFile_p);
        _cleanup(outputFiles_pp, inputHeader->num_channels, (uint64_t **)bytesWritten_pp);
        exit(1);
    }

    // initialize output files on first chunk
    if (chunkIndex == 1) {
        _init_output_files(inputFile_p, outputFiles_pp, inputHeader, (size_t **)bytesWritten_pp, outputPath_p);
        printf("Created output files for %d channels\n", inputHeader->num_channels);
    }

    return inputFile_p;
}


void extract_audio_from_chunk(FILE *inputFile_p, const WavHeader *inputHeader,
                             uint8_t **writeBuffers_pp, size_t *bufferFillBytes_p,
                             size_t bufferSizeBytes, FILE **outputFiles_pp,
                             size_t *bytesWritten_p) {
    // choose a read block size aimed to reduce syscall overhead
    const uint16_t bytesPerSample = inputHeader->bits_per_sample / 8;
    const size_t blockAlign = inputHeader->block_align;

    // frames per read must be at least 1 and such that read size is multiple of blockAlign
    size_t framesPerRead = (READ_BUFFER_SIZE_MB  * 1024 * 1024) / blockAlign;
    if (framesPerRead == 0) {
        framesPerRead = 1;
    }

    const size_t readBufferSize = framesPerRead * blockAlign;
    uint8_t *readBuffer_p = malloc(readBufferSize);
    if (!readBuffer_p) {
        fprintf(stderr, "ERROR: Failed to allocate read buffer\n");
        exit(1);
    }

    // Read blocks of interleaved frames and deinterleave into channel buffers
    while (1) {
        size_t framesRead = fread(readBuffer_p, blockAlign, framesPerRead, inputFile_p);
        if (framesRead == 0) {
            break;
        }

        // for each frame, distribute samples to channel buffers
        for (size_t currentFrame = 0; currentFrame < framesRead; currentFrame++) {
            uint8_t *frameBase = readBuffer_p + currentFrame * blockAlign;
            for (int currentChannel = 0; currentChannel < inputHeader->num_channels; currentChannel++) {
                uint8_t *src = frameBase + currentChannel * bytesPerSample;
                uint8_t *dst = writeBuffers_pp[currentChannel] + bufferFillBytes_p[currentChannel];
                memcpy(dst, src, bytesPerSample);
                bufferFillBytes_p[currentChannel] += bytesPerSample;

                // if buffer is full, flush it
                if (bufferFillBytes_p[currentChannel] >= bufferSizeBytes) {
                    size_t toWrite = bufferFillBytes_p[currentChannel];
                    size_t written = fwrite(writeBuffers_pp[currentChannel], 1, toWrite, outputFiles_pp[currentChannel]);
                    if (written != toWrite) {
                        fprintf(stderr, "ERROR: Writing data to channel %d\n", currentChannel + 1);
                        free(readBuffer_p);
                        exit(1);
                    }
                    bytesWritten_p[currentChannel] += toWrite;
                    bufferFillBytes_p[currentChannel] = 0;
                }
            }
        }
    }

    free(readBuffer_p);
}


void flush_remaining_buffers(const WavHeader *inputHeader, uint8_t **writeBuffers_pp,
                            size_t *bufferFillBytes_p, FILE **outputFiles_pp,
                            size_t *bytesWritten_p) {
    for (int i = 0; i < inputHeader->num_channels; i++) {
        if (bufferFillBytes_p[i] > 0) {
            size_t toWrite = bufferFillBytes_p[i];
            size_t written = fwrite(writeBuffers_pp[i], 1, toWrite, outputFiles_pp[i]);
            if (written != toWrite) {
                fprintf(stderr, "ERROR: Writing remaining data to channel %d\n", i + 1);
                exit(1);
            }
            bytesWritten_p[i] += toWrite;
        }
        free(writeBuffers_pp[i]);
    }

    free(writeBuffers_pp);
    free(bufferFillBytes_p);
}


void finalize_output_files(const WavHeader *inputHeader, size_t **bytesWritten_pp,
                          FILE ***outputFiles_pp) {
    if (*outputFiles_pp) {
        _rewrite_headers(inputHeader, (uint64_t **)bytesWritten_pp, outputFiles_pp);
        _cleanup(outputFiles_pp, inputHeader->num_channels, (uint64_t **)bytesWritten_pp);
    }
    printf("Header rewriting completed and files closed.\n");
}
